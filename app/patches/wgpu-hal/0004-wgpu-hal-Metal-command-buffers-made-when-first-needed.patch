+        let Some(first_command_buffer) = command_buffers.iter().find_map(|c| c.raw.as_ref()) else {
             return;
         };
         let desc = MTLResidencySetDescriptor::new();
-        desc.setLabel(first_command_buffer.raw.label().as_deref());
+        desc.setLabel(first_command_buffer.label().as_deref());
