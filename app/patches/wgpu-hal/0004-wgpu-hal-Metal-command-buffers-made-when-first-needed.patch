         // backends, which clear in `begin_encoding` rather than `discard_encoding`.
         debug_assert!(self.state.pending_timer_queries.is_empty());
 
-        self.raw_cmd_buf = Some(raw);
+        debug_assert!(self.raw_cmd_buf.is_none());
