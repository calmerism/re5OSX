+/// A pool of [`Tracker`]s for command buffers and compute passes, cleared,
+/// with their tables sized (re5osx: a new tracker grew tables over every
+/// buffer and texture index of the device, for each command buffer and
+/// compute pass).
+pub(crate) type TrackerPool = Mutex<Vec<Tracker>>;
+
+/// The most trackers a [`TrackerPool`] keeps: more than are in flight at once
+/// (each command buffer until the GPU is done with it).
+pub(crate) const TRACKER_POOL_MAX: usize = 32;
+
 /// A full double sided tracker used by CommandBuffers.
 pub(crate) struct Tracker {
     /// Buffers used within this command buffer.
@@ -671,6 +681,21 @@ impl Tracker {
         }
     }
 
+    /// Empties the tracker for reuse, as [`Tracker::new`] would make it but
+    /// with its tables kept: only the members' entries are reset (re5osx).
+    pub fn clear(&mut self) {
+        self.buffers.clear();
+        self.textures.clear();
+        self.blas_s.clear();
+        self.tlas_s.clear();
+        self.views.clear();
+        self.bind_groups.clear();
+        self.compute_pipelines.clear();
+        self.render_pipelines.clear();
+        self.bundles.clear();
+        self.query_sets.clear();
+    }
+
     /// Iterates through all resources in the given bind group and adopts
     /// the state given for those resources in the UsageScope. It also
     /// removes all touched resources from the usage scope.
