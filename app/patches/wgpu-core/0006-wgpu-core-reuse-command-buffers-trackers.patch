+    /// An empty tracker for a command buffer or compute pass, from the pool
+    /// when there is one ([`Self::recycle_tracker`] gives it back).
+    pub(crate) fn new_tracker(&self) -> Tracker {
+        self.tracker_pool
+            .lock()
+            .pop()
+            .unwrap_or_else(|| Tracker::new(self.ordered_buffer_usages, self.ordered_texture_usages))
+    }
+
+    /// Empties a tracker [`Self::new_tracker`] gave and keeps it for reuse;
+    /// at most [`TRACKER_POOL_MAX`] are kept.
+    pub(crate) fn recycle_tracker(&self, mut tracker: Tracker) {
+        tracker.clear();
+        let mut pool = self.tracker_pool.lock();
+        if pool.len() < TRACKER_POOL_MAX {
+            pool.push(tracker);
+        }
+    }
+
     pub fn get_hal_counters(&self) -> wgt::HalCounters {
         self.raw().get_internal_counters()
     }
