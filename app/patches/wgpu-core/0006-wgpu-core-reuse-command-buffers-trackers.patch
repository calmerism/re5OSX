+impl Drop for EncoderInFlight {
+    /// The command buffer is done: its tracker goes back to the device's pool
+    /// (re5osx).
+    fn drop(&mut self) {
+        let device = &self.inner.device;
+        let trackers = mem::replace(
+            &mut self.trackers,
+            Tracker::new(device.ordered_buffer_usages, device.ordered_texture_usages),
+        );
+        device.recycle_tracker(trackers);
+    }
+}
+
 /// A private command encoder for writes made directly on the device
 /// or queue.
 ///
