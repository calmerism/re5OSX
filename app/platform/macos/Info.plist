<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIconName</key>
    <string>re5OSX</string>
    <key>LSSupportsGameMode</key>
    <true/>
    <key>GCSupportsGameMode</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- GTA Online: players on the same network find each other there; the
         game's files stream from (or are shared with) other devices, found by Bonjour. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>re5OSX finds Online players and devices sharing the game on your network, and lets browsers there open Mod Studio.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_re5osx._tcp</string>
    </array>
</dict>
</plist>
